<!DOCTYPE html>
<html><head><meta charset="utf-8"></head>
<body>
<script>
var log = [];
var f = document.createElement('iframe');
f.src = 'index.html?bust=' + Date.now();
f.style.width = '390px'; f.style.height = '844px'; f.style.border = 'none';
document.body.appendChild(f);
var w, d;
function q(s) { return d.querySelector(s); }
f.addEventListener('load', function () {
  w = f.contentWindow; d = f.contentDocument;
  setTimeout(run, 500);
  function run() {
    w.setCust('guest'); w.go('s1');
    setTimeout(function () {
      /* ---- 1. 顾客卡展开后的 opacity/transform 随时间 ---- */
      var body = d.getElementById('s1BillBody');
      var card = body.querySelector('.v2-ccard');
      q('#s1 .nav-cust').click();
      [0, 60, 160, 300, 500, 900].forEach(function (t, i) {
        setTimeout(function () {
          log.push('T+' + t + 'ms cust-open=' + body.classList.contains('cust-open') +
            ' wrapH=' + Math.round(body.querySelector('[data-ccard-wrap]').getBoundingClientRect().height) +
            ' opacity=' + getComputedStyle(card).opacity + ' transform=' + getComputedStyle(card).transform);
        }, t);
      });
      /* ---- 2. 挂单 toast 时序 ---- */
      setTimeout(function () {
        var b = q('#s1 .v2-cat-item .v2-add-btn');
        b.click();
        setTimeout(function () {
          q('#addSheetMask .addsheet__foot .btn-confirm').click();
          log.push('after confirm toast=' + q('#toast').textContent);
          setTimeout(function () {
            log.push('before guard click toast=' + q('#toast').textContent + ' cart=' + w.cartItems.length);
            q('#s1 [data-guadan="s1"]').click();
            log.push('immediately after guard click: toast=' + q('#toast').textContent +
              ' display=' + q('#toast').style.display + ' cart=' + w.cartItems.length +
              ' screen=' + (function () { return Array.prototype.filter.call(d.querySelectorAll('.screen'), function (s) { return getComputedStyle(s).display !== 'none'; }).map(function (s) { return s.id; }).join(','); })());
            [50, 200, 600, 1200, 1600].forEach(function (t) {
              setTimeout(function () {
                log.push('guard T+' + t + 'ms toast=' + q('#toast').textContent + ' display=' + q('#toast').style.display);
              }, t);
            });
            setTimeout(function () {
              var pre = document.createElement('pre');
              pre.textContent = log.join('\n');
              document.body.appendChild(pre);
            }, 1800);
          }, 400);
        }, 400);
      }, 1200);
    }, 600);
  }
});
</script><iframe src="index.html?bust=1789721830790" style="width: 390px; height: 844px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;"></iframe>

<pre>T+0ms cust-open=true wrapH=16 opacity=1 transform=none
T+60ms cust-open=true wrapH=85 opacity=1 transform=none
T+160ms cust-open=true wrapH=140 opacity=1 transform=none
T+300ms cust-open=true wrapH=149 opacity=1 transform=none
T+500ms cust-open=true wrapH=120 opacity=1 transform=none
T+900ms cust-open=true wrapH=120 opacity=1 transform=none
after confirm toast=
before guard click toast= cart=1
immediately after guard click: toast=挂单成功 display=block cart=0 screen=s14
guard T+50ms toast=挂单成功 display=block
guard T+200ms toast=挂单成功 display=block
guard T+600ms toast=已加入购物车 display=block
guard T+1200ms toast=已加入购物车 display=block
guard T+1600ms toast=已加入购物车 display=block</pre></body></html>
