<!DOCTYPE html>
<html><head><meta charset="utf-8"></head>
<body>
<iframe id="f" style="width:390px;height:844px;border:0" src="index.html?capture=s1-expand&amp;bust=1789722497306"></iframe>
<pre id="out">ms=8200 screens=16 go=true sync=true bodyLen=197182</pre>
<script>
var f = document.getElementById('f');
var out = document.getElementById('out');
var t0 = Date.now();
var iv = setInterval(function () {
  var w, d;
  try { w = f.contentWindow; d = w ? w.document : null; } catch (e) { out.textContent = 'ERR ' + e.message; return; }
  if (!w || !d || !d.querySelector) { out.textContent = 'no doc ' + (Date.now() - t0); return; }
  var screens = d.querySelectorAll('.screen').length;
  var hasSync = typeof w.__v2SyncHold === 'function';
  var hasGo = typeof w.go === 'function';
  var booted = d.querySelectorAll('.screen').length && d.querySelectorAll('.screen:not([style*="display: none"])').length;
  out.textContent = 'ms=' + (Date.now() - t0) + ' screens=' + screens + ' go=' + hasGo + ' sync=' + hasSync + ' bodyLen=' + (d.body ? d.body.innerHTML.length : -1);
  if (Date.now() - t0 > 8000) clearInterval(iv);
}, 200);
f.src = 'index.html?capture=s1-expand&bust=' + Date.now();
</script>

</body></html>
